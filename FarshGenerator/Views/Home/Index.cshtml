@model IEnumerable<FarshGenerator.Models.Listing>
@{
    ViewData["Title"] = "Главная";
}

<section class="relative bg-[#0f1617] border-b border-[#395462] overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?q=80&w=1920&auto=format&fit=crop" alt="Motorcycle background" class="w-full h-full object-cover opacity-30 grayscale">
        <div class="absolute inset-0 bg-gradient-to-r from-[#0f1617] via-[#0f1617]/80 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-container-max mx-auto px-6 py-24 md:py-32">
        <div class="max-w-4xl">
            <h1 class="font-headline-xl md:text-display-md text-[#cce0dd] uppercase tracking-tight leading-none mb-6">
                Найди свой <span class="text-[#7da1b1]">предел</span>
            </h1>
            <p class="font-body-lg md:text-title-lg text-[#b3d1cb] mb-12 max-w-xl">
                Агрегатор высокопроизводительных мотоциклов. От трековых ракет до бескомпромиссных стритфайтеров.
            </p>

            <div class="bg-[#395462]/60 p-6 rounded-DEFAULT border border-[#7da1b1]/30 backdrop-blur-md">
                <form asp-action="Browse" method="get" class="flex flex-col gap-4">
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-grow">
                            <input name="SearchQuery" type="text" placeholder="Поиск по модели или тексту..." class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm px-4 focus:outline-none focus:border-[#701217]">
                        </div>
                        <div class="w-full md:w-56 relative">
                            <select name="BrandId" asp-items="ViewBag.Brands" class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm pl-4 pr-10 appearance-none focus:outline-none focus:border-[#701217]">
                                <option value="">Любая марка</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none">expand_more</span>
                        </div>
                        <div class="w-full md:w-56 relative">
                            <select name="CategoryId" asp-items="ViewBag.Categories" class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm pl-4 pr-10 appearance-none focus:outline-none focus:border-[#701217]">
                                <option value="">Любой класс</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-grow grid grid-cols-2 md:grid-cols-4 gap-4">
                            <input name="MinPrice" type="number" placeholder="Цена от (BYN)" class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm px-4 focus:outline-none focus:border-[#701217]">
                            <input name="MaxPrice" type="number" placeholder="Цена до (BYN)" class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm px-4 focus:outline-none focus:border-[#701217]">
                            <input name="MinYear" type="number" placeholder="Год от" class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm px-4 focus:outline-none focus:border-[#701217]">
                            <input name="MaxYear" type="number" placeholder="Год до" class="w-full h-12 bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-sm px-4 focus:outline-none focus:border-[#701217]">
                        </div>
                        <button type="submit" class="h-12 w-full md:w-auto bg-[#7da1b1] hover:bg-[#9db9c9] text-[#0f1617] font-label-bold uppercase px-10 rounded-sm transition-colors whitespace-nowrap">
                            Найти
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="max-w-container-max mx-auto px-6 py-20">
    <div class="flex justify-between items-end mb-10 border-b border-[#395462] pb-4">
        <h2 class="font-headline-lg text-[#cce0dd] uppercase tracking-tight">Последние поступления</h2>
        <a asp-action="Browse" class="font-label-bold text-[#7da1b1] hover:text-[#cce0dd] uppercase flex items-center transition-colors">
            Смотреть все <span class="material-symbols-outlined ml-1">arrow_forward</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var bike in Model)
        {
            var mainImg = bike.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? bike.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=800&q=80";

            <article class="relative group rounded-DEFAULT overflow-hidden border-t border-[#7da1b1]/50 bg-[#395462] flex flex-col h-[420px] shadow-lg">
                <div class="relative h-56 w-full overflow-hidden">
                    <img src="@mainImg" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="absolute top-4 right-4 bg-[#701217] text-white font-label-bold px-3 py-1 uppercase rounded-sm shadow-md">
                        @bike.Spec.Year
                    </div>
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[#7da1b1] font-label-sm uppercase tracking-wider">@bike.Spec.Category.Name</span>
                        <span class="text-[#b3d1cb] font-label-sm">@bike.Spec.EngineDisplacement cc</span>
                    </div>
                    <h3 class="font-headline-md text-[#cce0dd] uppercase tracking-tight mb-auto leading-tight">@bike.Spec.Brand.Name <br /><span class="text-[#b3d1cb]">@bike.Spec.Model</span></h3>

                    <div class="flex justify-between items-end mt-4">
                        <div>
                            <p class="font-label-sm text-[#b3d1cb] uppercase mb-1">Цена</p>
                            <span class="font-title-lg text-[#7da1b1] font-bold">@bike.Price.ToString("N0") @bike.Currency</span>
                        </div>
                        <a asp-action="TechSpecs" asp-route-id="@bike.Id" class="bg-[#0f1617] hover:bg-[#7da1b1] hover:text-[#0f1617] text-[#cce0dd] border border-[#7da1b1] px-5 py-2 font-label-bold text-sm uppercase rounded-DEFAULT transition-colors">
                            Обзор
                        </a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>