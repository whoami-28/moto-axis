@model FarshGenerator.Models.ViewModels.SellViewModel
@{
    ViewData["Title"] = "Продать";
}

<section class="py-20 max-w-4xl mx-auto px-6">
    <div class="bg-[#395462]/90 p-10 rounded-DEFAULT border-t border-[#7da1b1]/50 shadow-2xl">
        <h1 class="font-headline-lg text-[#cce0dd] uppercase tracking-tight mb-2">Разместить объявление</h1>
        <p class="font-body-md text-[#b3d1cb] mb-8">Ваша машина заслуживает достойного владельца.</p>

        <form asp-action="Sell" method="post" enctype="multipart/form-data" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Марка</label>
                    <div class="relative">
                        <select asp-for="BrandId" asp-items="Model.Brands" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 pl-4 pr-10 appearance-none focus:outline-none focus:border-[#701217]"></select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none">expand_more</span>
                    </div>
                    <span asp-validation-for="BrandId" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Модель</label>
                    <input asp-for="BikeModel" type="text" placeholder="напр. S1000RR" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]">
                    <span asp-validation-for="BikeModel" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Класс мотоцикла</label>
                    <div class="relative">
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 pl-4 pr-10 appearance-none focus:outline-none focus:border-[#701217]"></select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none">expand_more</span>
                    </div>
                    <span asp-validation-for="CategoryId" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Год выпуска</label>
                    <input asp-for="Year" type="number" placeholder="2024" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]">
                    <span asp-validation-for="Year" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Объем (cc)</label>
                    <input asp-for="EngineDisplacement" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]">
                    <span asp-validation-for="EngineDisplacement" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Мощность (л.с.)</label>
                    <input asp-for="EnginePower" type="number" step="0.1" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]">
                    <span asp-validation-for="EnginePower" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Пробег (км)</label>
                    <input asp-for="Mileage" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]">
                    <span asp-validation-for="Mileage" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Цена ($)</label>
                    <input asp-for="Price" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]">
                    <span asp-validation-for="Price" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Привод</label>
                    <div class="relative">
                        <select asp-for="DriveType" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 pl-4 pr-10 appearance-none focus:outline-none focus:border-[#701217]">
                            <option value="Chain">Цепь</option>
                            <option value="Belt">Ремень</option>
                            <option value="Shaft">Кардан</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none">expand_more</span>
                    </div>
                    <span asp-validation-for="DriveType" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Трансмиссия</label>
                    <div class="relative">
                        <select asp-for="Transmission" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 pl-4 pr-10 appearance-none focus:outline-none focus:border-[#701217]">
                            <option value="Manual">Механика (Manual)</option>
                            <option value="Quickshifter">Квикшифтер</option>
                            <option value="Automatic">Автомат (DCT)</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none">expand_more</span>
                    </div>
                    <span asp-validation-for="Transmission" class="text-[#ffb4ab] text-xs mt-1 block"></span>
                </div>
            </div>

            <div>
                <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Фотография</label>
                <input asp-for="ImageUpload" type="file" accept="image/*" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217] file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-label-bold file:bg-[#7da1b1] file:text-[#0f1617] hover:file:bg-[#9db9c9]">
                <span asp-validation-for="ImageUpload" class="text-[#ffb4ab] text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Описание</label>
                <textarea asp-for="Description" rows="5" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-3 px-4 focus:outline-none focus:border-[#701217]"></textarea>
                <span asp-validation-for="Description" class="text-[#ffb4ab] text-xs mt-1 block"></span>
            </div>

            <button type="submit" class="w-full bg-[#701217] hover:bg-[#852224] text-[#cce0dd] font-label-bold uppercase py-4 rounded-DEFAULT transition-transform hover:-translate-y-0.5">
                Опубликовать
            </button>
        </form>
    </div>
</section>