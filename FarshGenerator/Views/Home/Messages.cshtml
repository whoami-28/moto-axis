@{
    ViewData["Title"] = "Сообщения";
}

<section class="py-12 max-w-4xl mx-auto px-6">
    <h1 class="font-headline-lg text-headline-lg text-on-surface uppercase tracking-tight mb-8 border-b border-[#395462] pb-4">
        Система сообщений
    </h1>

    <div class="bg-[#395462]/30 border border-[#7da1b1]/20 rounded-DEFAULT overflow-hidden">
        <div class="p-6 flex items-center justify-between hover:bg-[#395462] cursor-pointer transition-colors border-b border-[#0f1617]">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-[#701217] rounded-full flex items-center justify-center font-headline-md text-[#cce0dd]">D</div>
                <div>
                    <h4 class="font-label-bold uppercase text-on-surface">Дилер Ducati</h4>
                    <p class="font-body-md text-on-surface-variant text-sm mt-1">Одобрена тестовая поездка на Panigale V4 R. Ждем вас...</p>
                </div>
            </div>
            <div class="flex flex-col items-end">
                <span class="font-label-sm text-[#7da1b1] uppercase">14:30</span>
                <span class="bg-[#7da1b1] w-2 h-2 rounded-full mt-2"></span>
            </div>
        </div>

        <div class="p-6 flex items-center justify-between hover:bg-[#395462] cursor-pointer transition-colors border-b border-[#0f1617] opacity-60 hover:opacity-100">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-[#0f1617] border border-[#7da1b1] rounded-full flex items-center justify-center font-headline-md text-[#7da1b1]">S</div>
                <div>
                    <h4 class="font-label-bold uppercase text-on-surface">Служба поддержки</h4>
                    <p class="font-body-md text-on-surface-variant text-sm mt-1">Ваше объявление по продаже Yamaha MT-09 опубликовано.</p>
                </div>
            </div>
            <div class="flex flex-col items-end">
                <span class="font-label-sm text-on-surface-variant uppercase">Вчера</span>
            </div>
        </div>

        <div class="p-6 flex items-center justify-between hover:bg-[#395462] cursor-pointer transition-colors opacity-60 hover:opacity-100">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-[#0f1617] border border-[#7da1b1] rounded-full flex items-center justify-center font-headline-md text-[#7da1b1]">А</div>
                <div>
                    <h4 class="font-label-bold uppercase text-on-surface">Александр (Покупатель)</h4>
                    <p class="font-body-md text-on-surface-variant text-sm mt-1">Здравствуйте, возможен ли торг у бака?</p>
                </div>
            </div>
            <div class="flex flex-col items-end">
                <span class="font-label-sm text-on-surface-variant uppercase">Пн, 12:00</span>
            </div>
        </div>
    </div>
</section>