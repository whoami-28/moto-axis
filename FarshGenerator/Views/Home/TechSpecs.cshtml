@model FarshGenerator.Models.Listing
@{
    ViewData["Title"] = "Характеристики " + Model.Spec.Model;
    var mainImg = Model.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? Model.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=800&q=80";
}

<section class="py-16 max-w-container-max mx-auto px-6">
    <a asp-action="Browse" class="font-label-bold text-[#7da1b1] hover:text-[#cce0dd] uppercase flex items-center mb-8 transition-colors">
        <span class="material-symbols-outlined mr-1">arrow_back</span> Назад в каталог
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="relative rounded-DEFAULT overflow-hidden border-t border-[#7da1b1]/50 shadow-2xl h-[500px]">
            <img src="@mainImg" class="absolute inset-0 w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0f1617] to-transparent opacity-60"></div>
            <div class="absolute bottom-4 left-4 flex space-x-2">
                <span class="bg-[#701217] text-white font-label-bold text-sm px-3 py-1 uppercase rounded-sm">@Model.Spec.Condition</span>
            </div>
        </div>

        <div class="flex flex-col">
            <h1 class="font-headline-xl text-[#cce0dd] uppercase tracking-tight mb-2">
                @Model.Spec.Brand.Name <span class="text-[#7da1b1]">@Model.Spec.Model</span>
            </h1>
            <p class="font-headline-md text-[#b3d1cb] mb-8">@Model.Price.ToString("N0") @Model.Currency</p>

            <h3 class="font-label-bold uppercase text-[#7da1b1] border-b border-[#395462] pb-2 mb-4">Технические данные</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4 mb-8">
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase">Мощность</p>
                    <p class="font-label-bold text-[#cce0dd] text-lg">@Model.Spec.EnginePower л.с.</p>
                </div>
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase">Объем двигателя</p>
                    <p class="font-label-bold text-[#cce0dd] text-lg">@Model.Spec.EngineDisplacement cc</p>
                </div>
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase">Привод</p>
                    <p class="font-label-bold text-[#cce0dd] text-lg">@Model.Spec.DriveType</p>
                </div>
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase">Трансмиссия</p>
                    <p class="font-label-bold text-[#cce0dd] text-lg">@Model.Spec.Transmission</p>
                </div>
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase">Год выпуска</p>
                    <p class="font-label-bold text-[#cce0dd] text-lg">@Model.Spec.Year</p>
                </div>
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase">Пробег</p>
                    <p class="font-label-bold text-[#cce0dd] text-lg">@Model.Spec.Mileage км</p>
                </div>
            </div>

            <h3 class="font-label-bold uppercase text-[#7da1b1] border-b border-[#395462] pb-2 mb-4">Описание от продавца</h3>
            <div class="bg-[#395462]/30 p-4 border border-[#7da1b1]/30 rounded-sm mb-8">
                <p class="font-body-md text-[#cce0dd] whitespace-pre-wrap">@Model.Description</p>
            </div>

            <div class="mt-auto bg-[#0f1617] border border-[#7da1b1]/50 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between">
                <div>
                    <p class="font-label-sm text-[#b3d1cb] uppercase mb-1">Продавец</p>
                    <p class="font-label-bold text-lg text-[#cce0dd] flex items-center">
                        <span class="material-symbols-outlined mr-2">person</span> @Model.Seller.Username
                    </p>
                    <p class="font-body-sm text-[#7da1b1] mt-1"><a href="mailto:@Model.Seller.Email">@Model.Seller.Email</a></p>
                </div>
                <a asp-action="SellerProfile" asp-route-id="@Model.SellerId" class="mt-4 sm:mt-0 bg-[#395462] hover:bg-[#7da1b1] text-[#cce0dd] hover:text-[#0f1617] font-label-bold uppercase py-2 px-6 rounded-DEFAULT transition-colors">
                    Профиль продавца
                </a>
            </div>
        </div>
    </div>
</section>