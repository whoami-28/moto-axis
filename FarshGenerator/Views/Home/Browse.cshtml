@model FarshGenerator.Models.ViewModels.BrowseViewModel
@{
    ViewData["Title"] = "Каталог мотоциклов";
}

<section class="max-w-container-max mx-auto px-6 py-12">
    <div class="flex flex-col lg:flex-row gap-8">

        <aside class="w-full lg:w-1/4">
            <div class="bg-[#395462]/50 p-6 rounded-DEFAULT border border-[#7da1b1]/30 sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="font-headline-md text-[#cce0dd] uppercase tracking-tight">Фильтры</h2>
                    <a asp-action="Browse" class="font-label-sm text-[#ffb4ab] hover:text-[#ffdad6] uppercase transition-colors">Сбросить</a>
                </div>

                <form asp-action="Browse" method="get" id="filterForm" class="space-y-5">
                    <input type="hidden" asp-for="PageNumber" id="pageNumberInput" />

                    <div>
                        <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Поиск</label>
                        <input asp-for="SearchQuery" type="text" placeholder="Модель или текст..." class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                    </div>

                    <div>
                        <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Марка</label>
                        <div class="relative">
                            <select asp-for="BrandId" asp-items="Model.Brands" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 pl-3 pr-8 appearance-none focus:outline-none focus:border-[#701217]">
                                <option value="">Любая марка</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>

                    <div>
                        <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Класс</label>
                        <div class="relative">
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 pl-3 pr-8 appearance-none focus:outline-none focus:border-[#701217]">
                                <option value="">Любой класс</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Цена от (BYN)</label>
                            <input asp-for="MinPrice" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Цена до (BYN)</label>
                            <input asp-for="MaxPrice" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Год от</label>
                            <input asp-for="MinYear" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Год до</label>
                            <input asp-for="MaxYear" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Объем от</label>
                            <input asp-for="MinDisplacement" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Объем до</label>
                            <input asp-for="MaxDisplacement" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Сил от (л.с.)</label>
                            <input asp-for="MinPower" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                        <div>
                            <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Пробег до</label>
                            <input asp-for="MaxMileage" type="number" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 px-3 focus:outline-none focus:border-[#701217]">
                        </div>
                    </div>

                    <div>
                        <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Привод</label>
                        <div class="relative">
                            <select asp-for="DriveType" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 pl-3 pr-8 appearance-none focus:outline-none focus:border-[#701217]">
                                <option value="">Любой</option>
                                <option value="Chain">Цепь</option>
                                <option value="Belt">Ремень</option>
                                <option value="Shaft">Кардан</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>

                    <div>
                        <label class="font-label-sm text-[#e3e3e3] mb-1 uppercase block">Трансмиссия</label>
                        <div class="relative">
                            <select asp-for="Transmission" class="w-full bg-[#0f1617] border border-[#7da1b1] text-[#cce0dd] rounded-DEFAULT py-2 pl-3 pr-8 appearance-none focus:outline-none focus:border-[#701217]">
                                <option value="">Любая</option>
                                <option value="Manual">Механика</option>
                                <option value="Quickshifter">Квикшифтер</option>
                                <option value="Automatic">Автомат (DCT)</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-[#b3d1cb] pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>

                    <button type="submit" onclick="document.getElementById('pageNumberInput').value = 1;" class="w-full bg-[#7da1b1] hover:bg-[#9db9c9] text-[#0f1617] font-label-bold uppercase py-3 rounded-DEFAULT transition-transform hover:-translate-y-0.5 mt-4">
                        Применить фильтры
                    </button>
                </form>
            </div>
        </aside>

        <div class="w-full lg:w-3/4 flex flex-col justify-between">
            <div>
                <div class="flex justify-between items-end mb-6 border-b border-[#395462] pb-4">
                    <h1 class="font-headline-xl text-[#cce0dd] uppercase tracking-tight">Каталог мотоциклов</h1>
                </div>

                @if (!Model.Listings.Any())
                {
                    <div class="bg-[#395462]/30 p-10 text-center rounded-DEFAULT border border-[#7da1b1]/30">
                        <p class="font-body-lg text-[#b3d1cb] mb-4">По вашему запросу ничего не найдено.</p>
                        <a asp-action="Browse" class="text-[#7da1b1] hover:underline font-label-bold uppercase tracking-wider">Сбросить фильтры</a>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                        @foreach (var bike in Model.Listings)
                        {
                            var mainImg = bike.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? bike.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=800&q=80";

                            <article class="relative group rounded-DEFAULT overflow-hidden border-t border-[#7da1b1]/30 bg-[#395462] flex flex-col h-[380px]">
                                <div class="relative h-48 w-full overflow-hidden">
                                    <img src="@mainImg" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                                    <div class="absolute top-3 right-3 bg-[#701217] text-white font-label-bold px-2 py-1 text-xs uppercase rounded-sm">
                                        @bike.Spec.Year
                                    </div>
                                </div>
                                <div class="p-5 flex flex-col flex-grow">
                                    <div class="flex items-center space-x-2 mb-2">
                                        <span class="text-[#7da1b1] font-label-sm uppercase tracking-wider">@bike.Spec.Category.Name</span>
                                        <span class="text-[#b3d1cb] text-xs">• @bike.Spec.EngineDisplacement cc</span>
                                    </div>
                                    <h3 class="font-label-bold text-[#cce0dd] uppercase tracking-tight mb-auto">@bike.Spec.Brand.Name @bike.Spec.Model</h3>

                                    <div class="flex justify-between items-center border-t border-[#0f1617] pt-4 mt-4">
                                        <span class="font-body-lg text-[#7da1b1] font-bold">@bike.Price.ToString("N0") @bike.Currency</span>
                                        <a asp-action="TechSpecs" asp-route-id="@bike.Id" class="bg-[#0f1617] hover:bg-[#7da1b1] hover:text-[#0f1617] text-[#cce0dd] border border-[#7da1b1] px-4 py-1.5 font-label-bold text-sm uppercase rounded-DEFAULT transition-colors">Обзор</a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="flex justify-center items-center space-x-2 mt-12 pt-6 border-t border-[#395462]/50">
                    @if (Model.PageNumber > 1)
                    {
                        <button onclick="changePage(@(Model.PageNumber - 1))" class="h-10 px-4 bg-[#395462] hover:bg-[#7da1b1] text-[#cce0dd] hover:text-[#0f1617] font-label-bold uppercase rounded-sm transition-colors flex items-center">
                            <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                        </button>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <span class="h-10 w-10 bg-[#701217] text-white font-label-bold rounded-sm flex items-center justify-center border border-[#701217]">
                                @i
                            </span>
                        }
                        else
                        {
                            <button onclick="changePage(@i)" class="h-10 w-10 bg-[#395462] hover:bg-[#7da1b1] text-[#cce0dd] hover:text-[#0f1617] font-label-bold rounded-sm flex items-center justify-center transition-colors">
                                @i
                            </button>
                        }
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <button onclick="changePage(@(Model.PageNumber + 1))" class="h-10 px-4 bg-[#395462] hover:bg-[#7da1b1] text-[#cce0dd] hover:text-[#0f1617] font-label-bold uppercase rounded-sm transition-colors flex items-center">
                            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                        </button>
                    }
                </div>
            }
        </div>

    </div>
</section>

@section Scripts {
    <script>
        function changePage(page) {
            document.getElementById('pageNumberInput').value = page;
            document.getElementById('filterForm').submit();
        }
    </script>
}